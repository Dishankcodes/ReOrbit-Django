# Copy to backend/.env and fill in. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=reorbit_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4028,http://127.0.0.1:4028

# Email. In DEBUG the code is printed in the terminal unless you set EMAIL_BACKEND.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Production email over HTTPS (Render's free plan blocks SMTP). Set one or more keys;
# they are tried in order Brevo, Resend, Mailjet (or the order in EMAIL_PROVIDERS).
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_SENDER=
EMAIL_SENDER_NAME=ReOrbit
EMAIL_PROVIDERS=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay test keys (phase A4). Leave empty until then.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Encrypts payout bank/UPI details in the database. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Background jobs (scheduled announcements, 30-day account deletions) run inside the server. False = run the commands yourself.
AUTO_JOBS=True

# Uploads: local folder in development; Cloudinary when DJANGO_ENV=production (or USE_CLOUDINARY=True).
DJANGO_ENV=development
# cloudinary://<api_key>:<api_secret>@<cloud_name>   (Cloudinary console > Settings > API Keys)
CLOUDINARY_URL=
# CLOUDINARY_FOLDER=reorbit
